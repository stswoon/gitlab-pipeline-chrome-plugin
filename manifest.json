{
  "manifest_version": 3,
  "name": "GitLab Pipeline Helper",
  "description": "Fill GitLab New pipeline Inputs from query params and manage profiles.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://gitlab.com/*",
    "https://*.gitlab.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gitlab.com/*",
        "https://*.gitlab.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
