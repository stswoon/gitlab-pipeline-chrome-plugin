{
  "name": "gitlab-pipeline-prefill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && npm run icons && vite build && vite build --config vite.content.config.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.4",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
